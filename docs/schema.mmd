
erDiagram
    INSTRUCTORS {
        int instructor_id PK
        string first_name
        string last_name
        string email UK
        string qualification
        boolean active
    }

    CUSTOMERS {
        int customer_id PK
        string first_name
        string last_name
        string email UK
        string phone
        date birth_date
        datetime registered_at
    }

    COURSES {
        int course_id PK
        string name
        string description
        decimal price
        int required_certification_id FK
        int duration_days
    }

    COURSE_SESSIONS {
        int session_id PK
        int course_id FK
        int instructor_id FK
        datetime start_time
        datetime end_time
        int max_participants
        string status
    }

    COURSE_BOOKINGS {
        int booking_id PK
        int customer_id FK
        int session_id FK
        datetime booked_at
        string booking_status
        string completion_status
    }

    EQUIPMENT {
        int equipment_id PK
        string inventory_number UK
        string equipment_type
        string manufacturer
        string model
        string size
        string condition
        string status
    }

    EQUIPMENT_ASSIGNMENTS {
        int assignment_id PK
        int booking_id FK
        int equipment_id FK
        datetime assigned_at
        datetime returned_at
        string status
    }

    EQUIPMENT_MAINTENANCE {
        int maintenance_id PK
        int equipment_id FK
        date maintenance_date
        date next_maintenance
        string description
        decimal cost
        string status
    }

    CERTIFICATIONS {
        int certification_id PK
        string name
        string organization
        string description
    }

    CUSTOMER_CERTIFICATIONS {
        int customer_certification_id PK
        int customer_id FK
        int certification_id FK
        string certificate_number UK
        date issued_at
        date expires_at
    }

    DIVE_SITES {
        int site_id PK
        string name
        string location
        int max_depth_meters
        string description
    }

    DIVE_TRIPS {
        int trip_id PK
        int site_id FK
        int instructor_id FK
        datetime start_time
        datetime end_time
        int max_participants
        decimal price
        string status
    }

    TRIP_PARTICIPANTS {
        int participant_id PK
        int trip_id FK
        int customer_id FK
        datetime registered_at
        string status
    }

    EQUIPMENT_RENTALS {
        int rental_id PK
        int equipment_id FK
        int customer_id FK
        datetime rental_start
        datetime rental_end
        datetime returned_at
        decimal price
        string status
    }

    INVOICES {
        int invoice_id PK
        int customer_id FK
        int booking_id FK
        int participant_id FK
        int rental_id FK
        string invoice_number UK
        decimal total_amount
        date issued_at
        date due_at
        string status
    }

    INSTRUCTORS ||--o{ COURSE_SESSIONS : teaches
    COURSES ||--o{ COURSE_SESSIONS : offers
    CUSTOMERS ||--o{ COURSE_BOOKINGS : books
    COURSE_SESSIONS ||--o{ COURSE_BOOKINGS : receives

    COURSE_BOOKINGS ||--o{ EQUIPMENT_ASSIGNMENTS : gets
    EQUIPMENT ||--o{ EQUIPMENT_ASSIGNMENTS : assigned_in

    EQUIPMENT ||--o{ EQUIPMENT_MAINTENANCE : has
    EQUIPMENT ||--o{ EQUIPMENT_RENTALS : rented_in
    CUSTOMERS ||--o{ EQUIPMENT_RENTALS : rents

    CERTIFICATIONS |o--o{ COURSES : prerequisite
    CERTIFICATIONS ||--o{ CUSTOMER_CERTIFICATIONS : type
    CUSTOMERS ||--o{ CUSTOMER_CERTIFICATIONS : earns

    DIVE_SITES ||--o{ DIVE_TRIPS : hosts
    INSTRUCTORS ||--o{ DIVE_TRIPS : guides
    DIVE_TRIPS ||--o{ TRIP_PARTICIPANTS : has
    CUSTOMERS ||--o{ TRIP_PARTICIPANTS : joins

    CUSTOMERS ||--o{ INVOICES : receives
    COURSE_BOOKINGS |o--o| INVOICES : billed_by
    TRIP_PARTICIPANTS |o--o| INVOICES : billed_by
    EQUIPMENT_RENTALS |o--o| INVOICES : billed_by
